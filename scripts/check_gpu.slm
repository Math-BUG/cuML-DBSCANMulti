#!/bin/bash
#SBATCH --job-name=dbscanmulti_check
#SBATCH --partition=scientific
#SBATCH --qos=scientific-qos
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --gres=gpu:1
#SBATCH --time=00:30:00
#SBATCH --output=job_%j.out
#SBATCH --error=job_%j.err

# Job curto de sanidade: compila o binário e roda a verificação embutida.
# Não rode isso no nó de login — o acesso direto à GPU pode estar bloqueado.
#
#   sbatch scripts/check_gpu.slm
#   squeue --me
#   cat job_<jobid>.out

set -euo pipefail

echo "SLURM_JOB_ID: ${SLURM_JOB_ID:-unset}"
echo "SLURM_NODELIST: ${SLURM_NODELIST:-unset}"
echo "CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES:-unset}"
echo "hostname: $(hostname)"
echo "date: $(date)"
echo "pwd: $(pwd)"

module --force purge
module load GCCcore/12.2.0
module load CUDA/12.6.0

# Isola o venv do site-packages da HOME, como no setup do INF-494.
export PYTHONNOUSERSITE=1

# Limita as bibliotecas nativas às CPUs alocadas; sem isso o OpenBLAS dos wheels enxerga
# todos os núcleos do nó e ultrapassa o NUM_THREADS com que foi compilado.
export OPENBLAS_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"
export MKL_NUM_THREADS="${SLURM_CPUS_PER_TASK:-8}"

nvidia-smi

PROJECT_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
cd "$PROJECT_DIR"
echo "project_dir: $(pwd)"

# /tmp é compartilhado e pode lotar durante o pré-processamento do nvcc.
# shellcheck disable=SC1091
source scripts/setup_job_tmp.sh

VENV_DIR="${VENV_DIR:-.venv}"
if [ ! -f "$VENV_DIR/bin/activate" ]; then
  echo "erro: venv não encontrado em '$VENV_DIR'; rode INSTALL_CUML=1 bash scripts/setup_env.sh" >&2
  exit 1
fi
# shellcheck disable=SC1090
source "$VENV_DIR/bin/activate"
echo "venv: $VENV_DIR ($(python --version 2>&1))"
python -c 'import cupy, rapids_logger; from cuml.cluster import DBSCAN' 2>/dev/null || {
  echo "erro: CuPy/cuML ausentes no venv; rode INSTALL_CUML=1 bash scripts/setup_env.sh" >&2
  exit 1
}

echo "--- toolchain ---"
nvcc --version

# Arquitetura da GPU alocada: evita depender de -arch=native, que exige GPU visível no
# momento da compilação e falha se o job for compilado em outro nó.
COMPUTE_CAP="$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader | head -n1 | tr -d '.')"
if [ -n "$COMPUTE_CAP" ]; then
  CUDA_ARCH="sm_${COMPUTE_CAP}"
else
  CUDA_ARCH="sm_80"
  echo "aviso: compute_cap não detectada, assumindo ${CUDA_ARCH}"
fi
echo "CUDA_ARCH: ${CUDA_ARCH}"

# Cabeçalhos de RAFT/RMM: o Makefile os descobre nos wheels do venv ativo. Em ambiente
# conda, exporte RAPIDS_INCLUDE=<prefixo>/include antes de submeter.
#
# LINK_RAFT=1 por padrão: é a configuração com a qual o link fecha neste cluster. Para
# tentar largar libraft.so (e as nccl/cublas/cusolver/cusparse que ela arrasta), submeta
# com --export=ALL,LINK_RAFT=0.
MAKE_ARGS=(CUDA_ARCH="$CUDA_ARCH" STD="${STD:-c++17}" LINK_RAFT="${LINK_RAFT:-1}")
if [ -n "${RAPIDS_INCLUDE:-}" ]; then
  MAKE_ARGS+=(RAPIDS_INCLUDE="$RAPIDS_INCLUDE")
fi
if [ -n "${CCCL_INCLUDE:-}" ]; then
  MAKE_ARGS+=(CCCL_INCLUDE="$CCCL_INCLUDE")
fi

CUVS_ARGS=("${MAKE_ARGS[@]}" BACKEND=cuvs)
CODES_ARGS=("${MAKE_ARGS[@]}" BACKEND=codes)

echo "--- build: backend cuvs (o caminho do cuML) ---"
make "${CUVS_ARGS[@]}"
CUVS_BIN="$(make --no-print-directory -s print-target "${CUVS_ARGS[@]}")"

echo "--- build: backend codes (sem cuVS) ---"
make "${CODES_ARGS[@]}"
CODES_BIN="$(make --no-print-directory -s print-target "${CODES_ARGS[@]}")"

echo "binario cuvs:  $CUVS_BIN"
echo "binario codes: $CODES_BIN"

# Tudo abaixo preserva suas saidas em build/ para que uma falha no job seja reproduzivel.
VALIDATION_DIR="${VALIDATION_DIR:-${BUILD_DIR:-build}/check_gpu_${SLURM_JOB_ID:-local}}"
mkdir -p "$VALIDATION_DIR"

echo "--- hash + build-info + manifesto ---"
python scripts/check_binary_identity.py --binary "$CUVS_BIN" \
  --backend cuvs --cuda-arch "$CUDA_ARCH" --require-identified \
  > "$VALIDATION_DIR/identity-cuvs.json"
python scripts/check_binary_identity.py --binary "$CODES_BIN" \
  --backend codes --cuda-arch "$CUDA_ARCH" --require-identified \
  > "$VALIDATION_DIR/identity-codes.json"

# O alvo selftest repete a atestacao imediatamente antes de executar o binario.
echo "--- selftest: backend cuvs ---"
make selftest "${CUVS_ARGS[@]}"
echo "--- selftest: backend codes ---"
make selftest "${CODES_ARGS[@]}"

expect_cli_failure() {  # $1=nome; os demais argumentos vao para o binario codes
  local name="$1" status
  shift
  set +e
  "$CODES_BIN" "$@" >"$VALIDATION_DIR/cli-${name}.out" \
                     2>"$VALIDATION_DIR/cli-${name}.err"
  status=$?
  set -e
  if [ "$status" -ne 2 ]; then
    echo "erro: caso CLI '$name' retornou $status; esperado 2" >&2
    exit 1
  fi
  if [ ! -s "$VALIDATION_DIR/cli-${name}.err" ]; then
    echo "erro: caso CLI '$name' falhou sem diagnostico em stderr" >&2
    exit 1
  fi
  echo "  ok: $name rejeitado com exit 2"
}

echo "--- validacao negativa da CLI ---"
CLI_BASE=(--input /dev/null --n 1 --d 1 --backend codes)
expect_cli_failure min-samples-zero "${CLI_BASE[@]}" --eps 1 --min-samples 0
expect_cli_failure eps-nan "${CLI_BASE[@]}" --eps nan --min-samples 1
expect_cli_failure max-mbytes-negativo "${CLI_BASE[@]}" --eps 1 --min-samples 1 \
  --max-mbytes-per-batch -1
expect_cli_failure neigh-per-row-negativo "${CLI_BASE[@]}" --eps 1 --min-samples 1 \
  --neigh-per-row -1

echo "--- matriz reduzida cuvs x codes x cuML x oraculo ---"
# O build cuvs contem as duas rotas compiladas; por isso a matriz usa somente CUVS_BIN.
# stdout/stderr e artefatos de divergencia ficam preservados mesmo quando o gate falha.
MATRIX_STDOUT="$VALIDATION_DIR/validation-matrix.stdout.jsonl"
MATRIX_STDERR="$VALIDATION_DIR/validation-matrix.stderr.log"
set +e
python tools/run_validation_matrix.py \
  --binary "$CUVS_BIN" \
  --random-seeds "${MATRIX_RANDOM_SEEDS:-3}" \
  --repetitions "${MATRIX_REPETITIONS:-2}" \
  --falhas-dir "$VALIDATION_DIR/falhas-matrix" \
  --out "$VALIDATION_DIR/validation-matrix.json" \
  > "$MATRIX_STDOUT" 2> "$MATRIX_STDERR"
MATRIX_STATUS=$?
set -e
if [ "$MATRIX_STATUS" -ne 0 ]; then
  cat "$MATRIX_STDERR" >&2
  echo "erro: matriz retornou $MATRIX_STATUS; artefatos em $VALIDATION_DIR" >&2
  exit "$MATRIX_STATUS"
fi
cat "$MATRIX_STDOUT"

echo "artefatos de validacao: $VALIDATION_DIR"

echo "Finalizado em: $(date)"
