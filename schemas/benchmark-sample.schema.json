{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Math-BUG/cuML-DBSCANMulti/schemas/benchmark-sample.schema.json",
  "title": "cuML-DBSCANMulti raw benchmark sample",
  "description": "Um registro JSONL por amostra medida. Warmups executados e descartados pertencem ao protocolo/manifesto; o runtime atual não expõe seu tempo individual. Agregados não pertencem a este contrato.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "campaign_id",
    "run_id",
    "case_id",
    "sample_id",
    "phase",
    "method",
    "sample_kind",
    "status",
    "block_index",
    "pair_index",
    "block_direction",
    "order_index",
    "repetition",
    "recorded_at",
    "identity",
    "parameters",
    "environment",
    "timings",
    "execution",
    "result",
    "error"
  ],
  "properties": {
    "$schema": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0.0"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "case_id": {"$ref": "#/$defs/id"},
    "sample_id": {"$ref": "#/$defs/id"},
    "phase": {"enum": ["pilot", "core"]},
    "method": {"enum": ["multi", "experimental_sequential", "cuml_sequential"]},
    "sample_kind": {"enum": ["warmup", "measured"]},
    "status": {"enum": ["ok", "failed", "semantic-rejected"]},
    "block_index": {"type": "integer", "minimum": 0},
    "pair_index": {"type": "integer", "minimum": 0},
    "block_direction": {"enum": ["forward", "reverse"]},
    "order_index": {"type": "integer", "minimum": 0},
    "repetition": {"type": "integer", "minimum": 0},
    "recorded_at": {"type": "string", "format": "date-time"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision",
        "revision_kind",
        "source_tree_sha256",
        "source_dirty",
        "binary_sha256",
        "build_id",
        "dataset_sha256",
        "dataset_metadata_sha256"
      ],
      "properties": {
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "revision_kind": {"enum": ["git", "source-tree-sha256", "provided"]},
        "source_tree_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 completo calculado pelo harness; source_revision guarda o prefixo de 40 hex do binario."
        },
        "source_dirty": {
          "type": ["boolean", "null"],
          "description": "null quando a árvore foi copiada ao cluster sem diretório .git; a identidade passa a ser source-tree-sha256."
        },
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "build_id": {"type": "string", "minLength": 1},
        "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dataset_metadata_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "n",
        "d",
        "seed",
        "backend",
        "route_requested",
        "index",
        "neigh_per_row",
        "max_mbytes_per_batch",
        "warmup_count",
        "k",
        "l",
        "configuration_count",
        "tier",
        "eps",
        "min_samples",
        "config_order",
        "precision",
        "metric"
      ],
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "n": {"type": "integer", "minimum": 1},
        "d": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"},
        "backend": {"enum": ["cuvs", "codes", "cuml"]},
        "route_requested": {"enum": ["annotated", "dense", "auto", "not-applicable"]},
        "index": {"enum": ["int32", "int64", "implementation-default"]},
        "neigh_per_row": {"type": "integer", "minimum": 0},
        "max_mbytes_per_batch": {"type": "integer", "minimum": 1},
        "warmup_count": {"type": "integer", "minimum": 1},
        "k": {"type": "integer", "minimum": 1},
        "l": {"type": "integer", "minimum": 1},
        "configuration_count": {"type": "integer", "minimum": 1},
        "tier": {"enum": ["pilot", "core", "stress"]},
        "eps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "min_samples": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1}
        },
        "config_order": {"const": "eps_major"},
        "precision": {"const": "float32"},
        "metric": {"const": "L2"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gpu_model",
        "gpu_uuid",
        "compute_capability",
        "vram_bytes",
        "driver_version",
        "cuda_runtime_version",
        "cuda_toolkit_version",
        "cuml_version",
        "cuvs_version",
        "raft_version",
        "rmm_version",
        "hostname",
        "slurm_job_id",
        "cuda_visible_devices"
      ],
      "properties": {
        "gpu_model": {"type": "string", "minLength": 1},
        "gpu_uuid": {"type": ["string", "null"], "minLength": 1},
        "compute_capability": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "vram_bytes": {"type": "integer", "minimum": 1},
        "driver_version": {"type": "string", "minLength": 1},
        "cuda_runtime_version": {"type": ["string", "integer"], "minLength": 1},
        "cuda_toolkit_version": {"type": ["string", "null"], "minLength": 1},
        "cuml_version": {"type": "string", "minLength": 1},
        "cuvs_version": {"type": "string", "minLength": 1},
        "raft_version": {"type": "string", "minLength": 1},
        "rmm_version": {"type": "string", "minLength": 1},
        "hostname": {"type": "string", "minLength": 1},
        "slurm_job_id": {"type": ["string", "null"], "minLength": 1},
        "cuda_visible_devices": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary",
        "setup_ms",
        "h2d_ms",
        "internal_setup_ms",
        "fit_ms",
        "d2h_ms",
        "end_to_end_ms",
        "configuration_fit_ms"
      ],
      "properties": {
        "boundary": {"const": "device-resident-input-to-device-labels"},
        "setup_ms": {"$ref": "#/$defs/nullableMilliseconds"},
        "h2d_ms": {"$ref": "#/$defs/nullableMilliseconds"},
        "internal_setup_ms": {"$ref": "#/$defs/nullableMilliseconds"},
        "fit_ms": {"$ref": "#/$defs/nullableMilliseconds"},
        "d2h_ms": {"$ref": "#/$defs/nullableMilliseconds"},
        "end_to_end_ms": {"$ref": "#/$defs/nullableMilliseconds"},
        "configuration_fit_ms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["config_index", "eps", "min_samples", "fit_ms"],
            "properties": {
              "config_index": {"type": "integer", "minimum": 0},
              "eps": {"type": "number", "exclusiveMinimum": 0},
              "min_samples": {"type": "integer", "minimum": 1},
              "fit_ms": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_budget_bytes",
        "effective_budget_bytes",
        "batch_size",
        "batches",
        "attempts",
        "batch_corrections",
        "route_observed",
        "routes_per_batch",
        "configuration_executions",
        "max_nnz",
        "total_nnz_max_eps",
        "density_max_eps",
        "peak_device_memory_bytes",
        "runtime_artifact",
        "telemetry_before",
        "telemetry_after"
      ],
      "properties": {
        "requested_budget_bytes": {"type": "integer", "minimum": 1},
        "effective_budget_bytes": {"type": ["integer", "null"], "minimum": 1},
        "batch_size": {"type": ["integer", "null"], "minimum": 1},
        "batches": {"type": ["integer", "null"], "minimum": 1},
        "attempts": {"type": ["integer", "null"], "minimum": 1},
        "batch_corrections": {"type": ["integer", "null"], "minimum": 0},
        "route_observed": {
          "type": ["string", "null"],
          "enum": ["annotated", "dense", "mixed", "not-applicable", "unknown", null]
        },
        "routes_per_batch": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["batch", "route", "nnz_max_eps"],
            "properties": {
              "batch": {"type": "integer", "minimum": 0},
              "route": {"enum": ["annotated", "dense", "not-applicable"]},
              "nnz_max_eps": {
                "type": ["integer", "null"],
                "minimum": 0,
                "description": "null enquanto o runtime expuser somente max_nnz e total_nnz_max_eps agregados."
              }
            }
          }
        },
        "configuration_executions": {
          "type": "array",
          "description": "Detalhes por fit escalar nos sweeps; vazio para a grade Multi.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "config_index",
              "effective_budget_bytes",
              "batch_size",
              "batches",
              "attempts",
              "batch_corrections",
              "route_observed",
              "max_nnz",
              "total_nnz_max_eps",
              "density_max_eps"
            ],
            "properties": {
              "config_index": {"type": "integer", "minimum": 0},
              "effective_budget_bytes": {"type": ["integer", "null"], "minimum": 1},
              "batch_size": {"type": ["integer", "null"], "minimum": 1},
              "batches": {"type": ["integer", "null"], "minimum": 1},
              "attempts": {"type": ["integer", "null"], "minimum": 1},
              "batch_corrections": {"type": ["integer", "null"], "minimum": 0},
              "route_observed": {
                "type": ["string", "null"],
                "enum": ["annotated", "dense", "mixed", "not-applicable", "unknown", null]
              },
              "max_nnz": {"type": ["integer", "null"], "minimum": 0},
              "total_nnz_max_eps": {"type": ["integer", "null"], "minimum": 0},
              "density_max_eps": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
            }
          }
        },
        "max_nnz": {"type": ["integer", "null"], "minimum": 0},
        "total_nnz_max_eps": {"type": ["integer", "null"], "minimum": 0},
        "density_max_eps": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "peak_device_memory_bytes": {"type": ["integer", "null"], "minimum": 0},
        "runtime_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "telemetry_before": {"$ref": "#/$defs/gpuTelemetry"},
        "telemetry_after": {"$ref": "#/$defs/gpuTelemetry"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clusters", "noise", "validation_status"],
      "properties": {
        "clusters": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "noise": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "validation_status": {
          "enum": ["approved-snapshot", "checked-identical", "checked-semantic", "failed", "not-run"]
        }
      }
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "message", "artifact"],
          "properties": {
            "type": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "artifact": {"type": ["string", "null"], "minLength": 1}
          }
        }
      ]
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "nullableMilliseconds": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "gpuTelemetry": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["timestamp", "temperature_c", "power_w", "sm_clock_mhz", "memory_clock_mhz", "utilization_percent", "memory_used_mib"],
          "properties": {
            "timestamp": {"type": "string", "format": "date-time"},
            "temperature_c": {"type": "number"},
            "power_w": {"type": "number", "minimum": 0},
            "sm_clock_mhz": {"type": "number", "minimum": 0},
            "memory_clock_mhz": {"type": "number", "minimum": 0},
            "utilization_percent": {"type": "number", "minimum": 0, "maximum": 100},
            "memory_used_mib": {"type": "number", "minimum": 0}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"method": {"const": "cuml_sequential"}},
        "required": ["method"]
      },
      "then": {
        "properties": {
          "parameters": {
            "properties": {
              "backend": {"const": "cuml"},
              "route_requested": {"const": "not-applicable"},
              "index": {"const": "implementation-default"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "parameters": {
            "properties": {"backend": {"enum": ["cuvs", "codes"]}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"method": {"const": "experimental_sequential"}},
        "required": ["method"]
      },
      "then": {
        "properties": {
          "parameters": {
            "properties": {"route_requested": {"const": "not-applicable"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"method": {"const": "multi"}},
        "required": ["method"]
      },
      "then": {
        "properties": {
          "parameters": {
            "properties": {
              "route_requested": {"enum": ["annotated", "dense", "auto"]}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "ok"}, "sample_kind": {"const": "measured"}},
        "required": ["status", "sample_kind"]
      },
      "then": {
        "properties": {
          "timings": {"properties": {"fit_ms": {"type": "number", "exclusiveMinimum": 0}}},
          "result": {
            "properties": {
              "clusters": {"minItems": 1},
              "noise": {"minItems": 1}
            }
          },
          "error": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"enum": ["failed", "semantic-rejected"]}},
        "required": ["status"]
      },
      "then": {"properties": {"error": {"type": "object"}}}
    },
    {
      "if": {
        "properties": {
          "method": {"enum": ["experimental_sequential", "cuml_sequential"]},
          "sample_kind": {"const": "measured"},
          "status": {"const": "ok"}
        },
        "required": ["method", "sample_kind", "status"]
      },
      "then": {
        "properties": {
          "timings": {"properties": {"configuration_fit_ms": {"minItems": 1}}}
        }
      }
    }
  ]
}
